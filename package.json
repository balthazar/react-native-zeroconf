{
  "name": "react-native-zeroconf",
  "version": "0.17.2",
  "description": "A Zeroconf discovery utility for react-native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint src",
    "format": "prettier --write src",
    "build": "bob build",
    "prepare": "bob build",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/types"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Apercu/react-native-zeroconf.git"
  },
  "files": [
    "src",
    "lib",
    "android",
    "android/generated",
    "!android/src/main/jni/mdnsresponder/mDNSWindows",
    "!android/src/main/jni/mdnsresponder/Clients",
    "!android/src/main/jni/mdnsresponder/android",
    "!android/src/main/jni/mdnsresponder/Makefile",
    "!android/src/main/jni/mdnsresponder/mDNSResponder.sln",
    "!android/src/main/jni/mdnsresponder/mdnsd.rc",
    "!android/src/main/jni/mdnsresponder/Android.bp",
    "!android/src/main/jni/mdnsresponder/PrivateDNS.txt",
    "!android/src/main/jni/mdnsresponder/mDNSCore/Implementer Notes.txt",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/Client.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/ExampleClientApp.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/ExampleClientApp.h",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/Identify.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/NetMonitor.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/ProxyResponder.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/Responder.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/nss_mdns.c",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/nss_mdns.conf",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/nss_mdns.conf.5",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/nss_ReadMe.txt",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/libnss_mdns.8",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/mdnsd.sh",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/parselog.py",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/Makefile",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/ReadMe.txt",
    "!android/src/main/jni/mdnsresponder/mDNSPosix/Services.txt",
    "!android/src/main/jni/mdnsresponder/mDNSShared/DebugServices.c",
    "!android/src/main/jni/mdnsresponder/mDNSShared/dnsextd.c",
    "!android/src/main/jni/mdnsresponder/mDNSShared/dnsextd.8",
    "!android/src/main/jni/mdnsresponder/mDNSShared/dnsextd.conf",
    "!android/src/main/jni/mdnsresponder/mDNSShared/dnsextd_lexer.l",
    "!android/src/main/jni/mdnsresponder/mDNSShared/dnsextd_parser.y",
    "!android/src/main/jni/mdnsresponder/mDNSShared/dns-sd.1",
    "!android/src/main/jni/mdnsresponder/mDNSShared/mDNS.1",
    "!android/src/main/jni/mdnsresponder/mDNSShared/mDNSResponder.8",
    "!android/build",
    "!android/.gradle",
    "windows",
    "!windows/**/*.user",
    "!windows/**/obj",
    "!windows/**/bin",
    "!windows/**/Generated Files",
    "ios",
    "ios/generated",
    "cpp",
    "react-native-zeroconf.podspec",
    "NOTICE",
    "react-native.config.js"
  ],
  "keywords": [
    "react-component",
    "react-native",
    "zeroconf",
    "bonjour",
    "avahi",
    "network",
    "lan",
    "ios",
    "android",
    "network-discovery",
    "discovery"
  ],
  "author": "Balthazar Gronon <bgronon@gmail.com>",
  "homepage": "https://zeroconf.balthazar.dev",
  "license": "MIT",
  "dependencies": {
    "events": "^3.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.82"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7",
    "@types/events": "^3.0.3",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.6.3",
    "prettier": "^3.2.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "jest": {
    "roots": [
      "<rootDir>/test"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/test/helpers/mockReactNative.js"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "RNZeroconfSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.balthazargronon.RCTZeroconf"
    },
    "includesGeneratedCode": true
  }
}
